# =============================================================================
# CodeHat Frontend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- Firebase Configuration ---
# Get these from: Firebase Console → Project Settings → General → Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Backend API ---
VITE_BACKEND_API=http://localhost:3000

# --- Google reCAPTCHA ---
# Get from: https://www.google.com/recaptcha/admin
VITE_SITE_KEY=your_recaptcha_site_key

# --- Social / Contact Links ---
VITE_EMAIL=your_email@example.com
VITE_GITHUB=https://github.com/your-username
VITE_X=https://x.com/your-handle
VITE_LinkedIn=https://linkedin.com/in/your-profile
VITE_StackOverflow=https://stackoverflow.com/users/your-id
